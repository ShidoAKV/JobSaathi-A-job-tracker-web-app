# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- Database (required) ----
# Local: mongodb://127.0.0.1:27017/jobsaathi
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/jobsaathi
MONGO_URI=mongodb://127.0.0.1:27017/jobsaathi

# ---- Auth (required) ----
JWT_SECRET=change_me_to_a_long_random_string

# ---- Google Gemini (optional: powers Resume Analyzer + chatbot AI answers) ----
# Without a key the chatbot still answers stats / top jobs / company listings from the DB.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Frontend origins ----
# Comma-separated list of allowed browser origins (CORS). Add your Render static site URL here.
CLIENT_URL=http://localhost:5173
# Public URL of the frontend, used in email links.
APP_URL=http://localhost:5173

# ---- Email via SMTP (optional: "new job" emails to all users) ----
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JobSaathi <no-reply@jobsaathi.app>"

# ---- Notification cron (node-cron syntax) ----
# How often to announce newly posted listings (in-app notifications + emails).
NOTIFY_CRON=*/2 * * * *

# ---- Admin accounts ----
# Comma-separated emails that are automatically given the admin role on signup/login.
ADMIN_EMAILS=

# ---- Rate limiting (express-rate-limit) ----
# Window length in minutes and the max number of /api requests per IP in that window.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
# Failed login/signup attempts per IP per window (successful requests are not counted).
AUTH_RATE_LIMIT_MAX=10
# Gemini-backed requests (chatbot + resume analysis) per user per window.
AI_RATE_LIMIT_MAX=30
# Listing posts / REST messages per user per minute.
WRITE_RATE_LIMIT_PER_MIN=30

# ---- Caching (node-cache, in-memory) ----
# Default TTL in seconds for cached GET responses (listings, analytics, admin stats) and chatbot answers.
CACHE_TTL_SECONDS=60
